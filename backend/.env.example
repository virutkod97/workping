DATABASE_URL="postgresql://workping:workping@localhost:5432/workping?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
# Múi giờ tính hạn & gửi nhắc việc
TZ_NAME="Asia/Ho_Chi_Minh"
# Số ngày trước hạn thì cảnh báo "Sắp đến hạn" (giống file Excel: 3)
WARN_DAYS=3
# Các mốc ngày gửi push nhắc riêng từng việc (trước hạn N ngày)
REMIND_DAYS="3,1,0"
# Lịch chạy nhắc việc hằng ngày (cron, theo TZ_NAME)
REMINDER_CRON="0 8 * * 1-6"
# Mật khẩu mặc định khi tạo nhân sự / import từ Excel
DEFAULT_PASSWORD="123456"
# Firebase Admin: đường dẫn file service account JSON (Firebase Console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# hoặc nội dung JSON mã hoá base64 (tiện cho Docker/CI)
FIREBASE_SERVICE_ACCOUNT_BASE64=""
# Tài khoản quản trị tạo khi seed
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin@123"
